    "@formkit/i18n": "^1.6.9",
    "@formkit/vue": "^1.6.9",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/vite": "^4.1.7",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.2.7",
    "@vueuse/core": "^13.2.0",
    "axios": "^1.9.0",
    "ol": "^10.5.0",
    "pinia": "^3.0.2",
    "sweetalert2": "^11.21.2",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "unplugin-fonts": "^1.3.1",
    "vue": "^3.5.14",
    "vue-i18n": "^11.1.4",
    "vue-router": "^4.5.1"
