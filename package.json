{
  "name": "mobility-assessment",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test:unit": "vitest",
    "db:types": "pnpx supabase gen types --lang=typescript --local > ./src/db/types/supabase.ts --schema public"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.6",
    "@fontsource/open-sans": "^5.2.5",
    "@formkit/addons": "^1.6.9",
