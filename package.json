    "@formkit/i18n": "^1.6.9",
    "@formkit/vue": "^1.6.9",
    "@headlessui/vue": "^1.7.23",
    "@pdfme/common": "^5.4.2",
    "@pdfme/generator": "^5.4.2",
    "@pdfme/manipulator": "^5.4.2",
    "@pdfme/schemas": "^5.4.2",
    "@supabase/supabase-js": "^2.56.1",
    "@tailwindcss/vite": "^4.1.12",
    "@tanstack/vue-table": "^8.21.3",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@vueuse/core": "^13.9.0",
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "jwt-decode": "^4.0.0",
    "mark.js": "^8.11.1",
    "ol": "^10.6.1",
    "ol-contextmenu": "^5.5.0",
    "ol-ext": "^4.0.34",
    "pinia": "^3.0.3",
    "sweetalert2": "^11.22.5",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "unplugin-fonts": "^1.4.0",
    "vue": "^3.5.21",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^11.1.11",
    "vue-router": "^4.5.1",
    "vue3-openlayers": "^12.1.0"
