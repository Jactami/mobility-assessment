{
  "name": "mobimeter",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "vue-tsc -b --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "clean": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
    "lint:check": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "test:unit": "vitest",
    "typecheck": "vue-tsc -b --noEmit",
    "icons": "pwa-assets-generator --preset minimal-2023 public/logo.svg && tauri icon public/logo.svg",
    "db:dump": "pnpx supabase db dump --data-only --local --schema public --file ./supabase/dump/dump.sql",
    "db:types": "pnpx supabase gen types --lang=typescript --local > ./src/db/types/supabase.ts --schema public && prettier --write ./src/db/types/supabase.ts",
    "ors:start": "docker-compose -f ./ors/docker-compose.yml up -d",
    "ors:stop": "docker-compose -f ./ors/docker-compose.yml down"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.1.11",
    "@fontsource/open-sans": "^5.2.7",
    "@formkit/addons": "^1.7.2",
    "@formkit/core": "^1.7.2",
    "@formkit/i18n": "^1.7.2",
    "@formkit/icons": "^1.7.2",
    "@formkit/vue": "^1.7.2",
    "@headlessui/vue": "^1.7.23",
    "@pdfme/common": "^5.5.8",
    "@pdfme/generator": "^5.5.8",
    "@pdfme/manipulator": "^5.5.8",
    "@pdfme/schemas": "^5.5.8",
    "@supabase/supabase-js": "^2.99.2",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/vue-table": "^8.21.3",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.6",
    "axios-retry": "^4.5.0",
    "chart.js": "^4.5.1",
    "jwt-decode": "^4.0.0",
    "mark.js": "^8.11.1",
    "ol": "^10.8.0",
    "ol-contextmenu": "^6.0.0",
    "ol-ext": "^4.0.38",
    "p-limit": "^7.3.0",
    "pinia": "^3.0.4",
    "sweetalert2": "^11.26.23",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "unplugin-fonts": "^1.4.0",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3",
    "vue3-openlayers": "^12.2.2"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.450",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/jsdom": "^28.0.0",
    "@types/mark.js": "^8.11.12",
    "@types/node": "^25.5.0",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.12",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/tsconfig": "^0.9.0",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "supabase": "^2.79.0",
    "typescript": "~5.9.3",
    "unplugin-icons": "^23.0.1",
    "vite": "^8.0.0",
    "vite-plugin-vue-devtools": "^8.1.0",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.5"
  }
}